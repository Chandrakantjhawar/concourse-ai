{
  "name": "concourse-ai-backend",
  "version": "1.0.0",
  "description": "Concourse AI — GenAI Co-Pilot for FIFA World Cup 2026",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "keywords": [
    "fifa",
    "worldcup",
    "genai",
    "gemini",
    "concourse"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@hono/node-server": "^1.14.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "envalid": "^8.0.0",
    "hono": "^4.8.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.16.4",
    "@vitest/coverage-v8": "^3.2.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  }
}
