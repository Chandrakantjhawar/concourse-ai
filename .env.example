# Concourse AI — Environment Variables
# Copy this to backend/.env and fill in your values

# Provider selection: 'auto' (recommended), 'gemini', 'groq', 'grok', 'openrouter', or 'openai'
AI_PROVIDER=auto

# Option 1: Google Gemini API (from Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Option 2: Groq Free API (Fast & free: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option 3: xAI Grok API (https://console.x.ai)
GROK_API_KEY=
GROK_MODEL=grok-beta

# Option 4: OpenRouter Free Models (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Option 5: OpenAI or compatible local endpoint (e.g. Ollama, LM Studio)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Set to true to skip AI calls and use deterministic local fallbacks
USE_LOCAL_FALLBACK=false

# Server port
PORT=8080

# Environment
NODE_ENV=development

